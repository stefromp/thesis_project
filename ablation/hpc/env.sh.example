# Compute-node environment for the ablation jobs.
#
#   cp ablation/hpc/env.sh.example ablation/hpc/env.sh
#   # edit for your cluster, then submit with:
#   #   --env_setup ablation/hpc/env.sh
#
# This file is SOURCED at the top of every generated batch script, so editing it
# changes all queued jobs without regenerating anything.

set -euo pipefail

# ---------------------------------------------------------------------------
# 1. Modules — names are cluster-specific; check with `module avail`.
# ---------------------------------------------------------------------------
# module purge
# module load cuda/11.8
# module load cudnn/8.6
# module load python/3.11

# ---------------------------------------------------------------------------
# 2. Python environment — pick ONE.
# ---------------------------------------------------------------------------
# conda: the shell hook is required, `conda activate` alone fails in a
# non-interactive batch shell.
# eval "$(conda shell.bash hook)"
# conda activate thesis

# venv:
# source "$HOME/thesis_project/.venv/bin/activate"

# ---------------------------------------------------------------------------
# 3. Keep caches off the home quota — these directories fill up fast and many
#    clusters enforce a small home filesystem.
# ---------------------------------------------------------------------------
# export TMPDIR="${SLURM_TMPDIR:-/tmp}"
# export MPLCONFIGDIR="$TMPDIR/mpl"
# export HF_HOME="$SCRATCH/.cache/huggingface"
# export TORCH_HOME="$SCRATCH/.cache/torch"

# CatBoost writes catboost_info/ into the working directory; on a shared
# filesystem with many concurrent array tasks that is contention you do not
# want. Give each task its own scratch.
# export CATBOOST_INFO_DIR="$TMPDIR/catboost_$SLURM_ARRAY_TASK_ID"

# ---------------------------------------------------------------------------
# 4. Thread limits. Array tasks share a node; without these, every task spawns
#    as many BLAS threads as the node has cores and they thrash each other.
# ---------------------------------------------------------------------------
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-4}"
export MKL_NUM_THREADS="${SLURM_CPUS_PER_TASK:-4}"

# ---------------------------------------------------------------------------
# 5. Sanity check — cheap, and it fails the job early with a clear message
#    instead of hours later inside the sampler.
# ---------------------------------------------------------------------------
python - <<'PYEOF'
import torch
print(f"torch {torch.__version__}  cuda_available={torch.cuda.is_available()}")
if torch.cuda.is_available():
    print(f"device: {torch.cuda.get_device_name(0)}")
try:
    import sdmetrics
    print(f"sdmetrics {sdmetrics.__version__}  (Shape/Trend/C2ST available)")
except ImportError:
    print("WARNING: sdmetrics missing -> Shape/Trend/C2ST will be skipped")
PYEOF
